# pey (https://docs.pey.mx). Copia este archivo a .env.local y llénalo. NUNCA subas .env.local.

# Llave del portal de pey → Developer → Create API Key (liga una cuenta CoDi).
PEY_API_KEY=

# Secreto del webhook (whsec_...). Se ve una sola vez al crear el webhook de la API key.
PEY_WEBHOOK_SECRET=

# Opcional: cambia la base de la API. Por defecto https://api.pey.mx
# PEY_API_BASE=
